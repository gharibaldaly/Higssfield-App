# -----------------------------------------------------------------------------
# Higgsfield App — environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# -----------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API. The anon key may be the legacy "anon" JWT or the new
# publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key (sb_secret_...). Optional: only the Higgsfield
# webhook route uses it. Without it the app polls for results instead.
SUPABASE_SERVICE_ROLE_KEY=

# The only account allowed into the studio (recommended).
APP_OWNER_EMAIL=

# Public URL of the deployment, e.g. https://higgsfield-studio.vercel.app
# Used to build Higgsfield webhook URLs.
APP_URL=

# --- Higgsfield (image & video generation) -----------------------------------
# API key from cloud.higgsfield.ai. The API authenticates with KEY_ID:KEY_SECRET:
# either put both halves in the two variables below, or the combined
# "KEY_ID:KEY_SECRET" string in HIGGSFIELD_API_KEY alone.
# With no key the app uses a built-in mock provider (placeholder results).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional overrides.
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Optional JSON model catalogue to merge into the model registry.
HIGGSFIELD_MODELS_URL=
# Optional: enables completion webhooks (also needs APP_URL and
# SUPABASE_SERVICE_ROLE_KEY). Any long random string.
HIGGSFIELD_WEBHOOK_SECRET=
# Set to 1 to force the mock provider even when a key is present.
HIGGSFIELD_MOCK=

# --- Director brain (LLM) ----------------------------------------------------
# Claude is the default; Gemini is the alternative (switch in Settings).
# With neither key the app uses a deterministic mock brain.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest).
GEMINI_MODEL=

# --- Google Drive mirror (Phase 2) -------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
