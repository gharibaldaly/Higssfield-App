# -----------------------------------------------------------------------------
# Higgsfield App — environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# -----------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API. The anon key may be the legacy "anon" JWT or the new
# publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key (sb_secret_...). Optional: only the Higgsfield
# webhook route uses it. Without it the app polls for results instead.
SUPABASE_SERVICE_ROLE_KEY=

# The only account allowed into the studio (recommended).
APP_OWNER_EMAIL=

# Public URL of the deployment, e.g. https://higgsfield-studio.vercel.app
# Used to build Higgsfield webhook URLs.
APP_URL=

# --- Higgsfield (image & video generation) -----------------------------------
# API key from console.higgsfield.ai (a key ID and a secret). The API
# authenticates with KEY_ID:KEY_SECRET: either put the key ID and the secret in
# the two variables below, or the combined "KEY_ID:KEY_SECRET" string in
# HIGGSFIELD_API_KEY (the combined form wins if both are set). No quotes needed.
# Settings shows whether Higgsfield accepts the key.
# With no key the app uses a built-in mock provider (placeholder results).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional overrides.
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Optional JSON model catalogue to merge into the model registry.
HIGGSFIELD_MODELS_URL=
# Optional: enables completion webhooks (also needs APP_URL and
# SUPABASE_SERVICE_ROLE_KEY). Any long random string.
HIGGSFIELD_WEBHOOK_SECRET=
# Set to 1 to force the mock provider even when a key is present.
HIGGSFIELD_MOCK=
# Requests the account may have queued or running at once (Higgsfield console →
# limits). Extra requests wait in the studio's queue. Default 4.
HIGGSFIELD_MAX_CONCURRENT=

# --- Director brain (LLM) ----------------------------------------------------
# Claude is the default; Gemini is the alternative (switch in Settings).
# With neither key the app uses a deterministic mock brain.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
ANTHROPIC_MODEL=
# A free key from Google AI Studio works: when one model's free daily limit
# runs out, the brain moves on to the other free models (earlier Flash,
# Flash-Lite, then Gemma 4) until the limits reset at midnight Pacific time.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest).
GEMINI_MODEL=

# --- Free director brains (checked 2026-09-28; see CLAUDE.md) ----------------
# Each needs only its key. Choose "Free gateways" under Settings → Director
# brain: the brain asks them in this order and moves on when one hits a limit.
# Mistral (console.mistral.ai): the Free plan includes $10 a month in API
# credits. Mistral Small 4 reads images (8 per request) at $0.15 / $0.60 per
# million input / output tokens, so the credits cover roughly 200–300 models a
# month; its reasoning is switched off. Mistral may use free-plan data for
# training unless that is switched off under Admin Console → Privacy.
MISTRAL_API_KEY=
# Optional model override (default: mistral-small-latest). It must read images.
MISTRAL_MODEL=
# Z.ai (z.ai/model-api): GLM-4.6V-Flash is free, one request at a time. Its
# default terms allow training on API data.
ZAI_API_KEY=
# Optional model override (default: glm-4.6v-flash).
ZAI_MODEL=
# OpenRouter (openrouter.ai): free models at 50 requests a day, 1,000 a day once
# $10 of credits were ever bought. Free routes may log prompts.
OPENROUTER_API_KEY=
# Optional model override (default: google/gemma-4-31b-it:free).
OPENROUTER_MODEL=

# --- Director brain through your own OpenAI-compatible gateway (optional) ----
# Any service with an OpenAI-style /chat/completions endpoint and a Bearer key.
# Choose "Gateway" under Settings → Director brain to use it.
# NVIDIA (build.nvidia.com, key starts with nvapi-):
#   LLM_GATEWAY_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_GATEWAY_MODEL=moonshotai/kimi-k3
#   LLM_GATEWAY_NAME=NVIDIA
#   LLM_GATEWAY_MAX_TOKENS=32000
#   LLM_GATEWAY_REASONING_EFFORT=off
# Base URL including the version path, https only, e.g. https://gateway.example/v1
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
# Default model id at the gateway (Settings can override). It must accept images.
LLM_GATEWAY_MODEL=
# Name shown in Settings, e.g. the gateway's brand.
LLM_GATEWAY_NAME=
# Optional output token cap sent to the gateway (default 16000). Thinking
# counts towards it, so reasoning models want more (Kimi K3 takes up to 65536).
LLM_GATEWAY_MAX_TOKENS=
# Optional reasoning_effort sent with every request (Kimi K3: low, high or max;
# its default is max, the slowest). "off" asks for as little thinking as the
# model allows (reasoning_effort low, and the chat template's thinking switch
# off). Each field is dropped for a model that refuses it.
LLM_GATEWAY_REASONING_EFFORT=

# --- Google Drive mirror (Phase 2) -------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
